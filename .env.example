# Cukupin Environment Variables
# Copy this file to .env.local for local development

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Local development (via `supabase start`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Cloud / Production (from Supabase Dashboard -> Settings -> API):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (optional, for administrative scripts only - DO NOT expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
